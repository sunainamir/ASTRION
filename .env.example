# PORT: HTTP and WebSocket server port (defaults to 3000)
PORT="3000"

# APP_URL: Public base URL where ASTRION is hosted (used for allowed WebSocket origin checks)
APP_URL="http://localhost:3000"

# ALLOWED_ORIGINS: Optional comma-separated list of additional allowed WebSocket origins in production
# ALLOWED_ORIGINS="https://example.com,https://www.example.com"

# NASA_API_KEY: Optional API key for NASA Open APIs (NeoWs).
# Read strictly on the server; defaults to NASA's public DEMO_KEY if omitted.
NASA_API_KEY="DEMO_KEY"
